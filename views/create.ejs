<%- include("partials/navbar.ejs") %>
<link href="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.snow.css" rel="stylesheet">
    <div class="min-h-screen bg-slate-50 py-10 px-4">


        <% if (typeof error !=="undefined" && error) { %>
            <div class="mb-5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">
                <%= error %>
            </div>
            <% } %>


                <form action="/create" method="post" enctype="multipart/form-data"
                    class="max-w-2xl mx-auto bg-white border border-slate-200 rounded-2xl shadow-lg p-6 sm:p-8">

                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <!-- Heading -->
                    <div class="text-center mb-8">
                        <p class="text-green-600 font-semibold text-sm mb-1">
                            Share your thoughts
                        </p>

                        <h1 class="text-3xl sm:text-4xl font-bold text-slate-900">
                            Create a Blog
                        </h1>

                        <p class="text-slate-500 text-sm mt-2">
                            Where ideas come alive.
                        </p>
                    </div>


                    <!-- Title -->
                    <div class="mb-5">
                        <label for="title" class="block text-sm font-semibold text-slate-700 mb-2">
                            Title <span class="text-red-500">*</span>
                        </label>

                        <input type="text" name="title" id="title"
                            placeholder="Enter your blog title" required
                            value="<%= typeof formData !== 'undefined' ? formData.title : '' %>"
                            aria-describedby="title-error"
                            class="w-full border border-slate-300 rounded-lg px-4 py-3 outline-none focus:border-green-500 focus:ring-2 focus:ring-green-100 transition">

                        <p id="title-error"
                            class="mt-1 text-sm text-red-600 <%= typeof fieldErrors !== 'undefined' && fieldErrors.title ? '' : 'hidden' %>"
                            role="alert">
                            <%= typeof fieldErrors !== 'undefined' && fieldErrors.title ? fieldErrors.title : '' %>
                        </p>
                    </div>



                    <!-- Category -->
                    <div class="mb-4">
                        <label for="category" class="block font-semibold mb-2">
                            Category <span class="text-red-500">*</span>
                        </label>

                        <select id="category" name="category" required
                            data-selected-category="<%= typeof formData !== 'undefined' ? formData.category : '' %>"
                            class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:border-green-500">
                            <option value="" disabled selected>
                                Select a category
                            </option>
                            <option value="Technology">Technology</option>
                            <option value="Programming">Programming</option>
                            <option value="Web Development">Web Development</option>
                            <option value="Mobile Development">Mobile Development</option>
                            <option value="Artificial Intelligence">Artificial Intelligence</option>
                            <option value="Data Science">Data Science</option>
                            <option value="Cybersecurity">Cybersecurity</option>
                            <option value="Databases">Databases</option>
                            <option value="Software Engineering">Software Engineering</option>
                            <option value="Cloud Computing">Cloud Computing</option>
                            <option value="DevOps">DevOps</option>
                            <option value="Education">Education</option>
                            <option value="Career &amp; Jobs">Career &amp; Jobs</option>
                            <option value="Freelancing">Freelancing</option>
                            <option value="Productivity">Productivity</option>
                            <option value="Personal Growth">Personal Growth</option>
                            <option value="Business &amp; Finance">Business &amp; Finance</option>
                            <option value="Lifestyle">Lifestyle</option>
                            <option value="Travel">Travel</option>
                            <option value="Reviews">Reviews</option>
                            <option value="Tutorials">Tutorials</option>
                            <option value="News &amp; Updates">News &amp; Updates</option>
                            <option value="Other">Other</option>
                        </select>

                        <p id="category-error"
                            class="mt-1 text-sm text-red-600 <%= typeof fieldErrors !== 'undefined' && fieldErrors.category ? '' : 'hidden' %>"
                            role="alert">
                            <%= typeof fieldErrors !== 'undefined' && fieldErrors.category ? fieldErrors.category : '' %>
                        </p>
                    </div>


                    <!-- Description -->
                    <div class="mb-5">
                        <label for="description" class="block text-sm font-semibold text-slate-700 mb-2">
                            Description <span class="text-red-500">*</span>
                        </label>

                        <input type="text" name="description" id="description"
                            placeholder="Write a short description" required
                            value="<%= typeof formData !== 'undefined' ? formData.description : '' %>"
                            aria-describedby="description-error"
                            class="w-full border border-slate-300 rounded-lg px-4 py-3 outline-none focus:border-green-500 focus:ring-2 focus:ring-green-100 transition">

                        <p id="description-error"
                            class="mt-1 text-sm text-red-600 <%= typeof fieldErrors !== 'undefined' && fieldErrors.description ? '' : 'hidden' %>"
                            role="alert">
                            <%= typeof fieldErrors !== 'undefined' && fieldErrors.description ? fieldErrors.description : '' %>
                        </p>
                    </div>



                    <!-- Content -->
                    <div class="mb-7">
                        <label class="block text-sm font-semibold text-slate-700 mb-2">
                            Content <span class="text-red-500">*</span>
                        </label>
 
                            <div id="editor" class="bg-white"></div>

                            <input type="hidden" name="content" id="content" required
                                value="<%= typeof formData !== 'undefined' ? formData.content : '' %>">

                            <p id="content-error"
                                class="mt-1 text-sm text-red-600 <%= typeof fieldErrors !== 'undefined' && fieldErrors.content ? '' : 'hidden' %>"
                                role="alert">
                                <%= typeof fieldErrors !== 'undefined' && fieldErrors.content ? fieldErrors.content : '' %>
                            </p>

                    </div>


                    <!-- Image  -->
                    <div class="mb-5">
                        <label for="image" class="block text-sm font-semibold text-slate-700 mb-2">
                            Blog Image
                        </label>

                        <input type="file" name="image" id="image" accept="image/*" class="w-full border border-slate-300 rounded-lg px-4 py-3
               outline-none focus:border-green-500 focus:ring-2
               focus:ring-green-100 transition bg-white">
                    </div>


                    <!-- Submit -->
                    <button type="submit" class="w-full bg-green-600 hover:bg-green-700
                   text-white font-semibold py-3 rounded-lg
                   transition duration-200 shadow-sm">
                        ✍️ Publish Blog
                    </button>

                </form>
                
                <script src="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.js"></script>

                <script>
                   
                        const quill = new Quill("#editor", {
                            theme: "snow",
                            placeholder: "Start writing your story...",
                            modules: {
                                toolbar: [
                                    [{ header: [1, 2, 3, false] }],
                                    ["bold", "italic", "underline", "strike"],
                                    [{ list: "ordered" }, { list: "bullet" }],
                                    ["blockquote", "link"],
                                    ["clean"]
                                ]
                            }
                        });

                        const form = document.querySelector('form[action="/create"]');
                        const contentInput = document.getElementById("content");

                        const titleInput = document.getElementById("title");
                        const descriptionInput = document.getElementById("description");

                        const titleError = document.getElementById("title-error");
                        const descriptionError = document.getElementById("description-error");
                        const contentError = document.getElementById("content-error");

                        const MAX_TITLE = 255;
                        const MAX_DESCRIPTION = 500;
                        const MAX_CONTENT = 20000;

                        // Restore the editor content after a server-side validation error.
                        if (contentInput.value) {
                            quill.clipboard.dangerouslyPasteHTML(contentInput.value);
                        }

                        function validateTextField(input, errorElement, maxLength, fieldName) {
                            const length = input.value.length;

                            if (length > maxLength) {
                                errorElement.textContent =
                                    `${fieldName} must not exceed ${maxLength} characters.`;
                                errorElement.classList.remove("hidden");
                                input.setAttribute("aria-invalid", "true");
                                return false;
                            }

                            errorElement.textContent = "";
                            errorElement.classList.add("hidden");
                            input.removeAttribute("aria-invalid");

                            return true;
                        }

                        function validateContent() {
                            const plainText = quill.getText().trim();
                            const html = quill.getSemanticHTML();

                            contentInput.value = html;

                            if (plainText && html.length > MAX_CONTENT) {
                                contentError.textContent =
                                    `Blog content exceeds the ${MAX_CONTENT}-character limit. Please shorten it.`;
                                contentError.classList.remove("hidden");
                                return false;
                            }

                            contentError.textContent = "";
                            contentError.classList.add("hidden");

                            return true;
                        }

                        // Validate as the user types.
                        titleInput.addEventListener("input", () => {
                            validateTextField(titleInput, titleError, MAX_TITLE, "Title");
                        });

                        descriptionInput.addEventListener("input", () => {
                            validateTextField(
                                descriptionInput,
                                descriptionError,
                                MAX_DESCRIPTION,
                                "Description"
                            );
                        });

                        quill.on("text-change", validateContent);

                        // Validate again before submission.
                        form.addEventListener("submit", function (event) {
                            const titleValid = validateTextField(
                                titleInput, titleError, MAX_TITLE, "Title"
                            );

                            const descriptionValid = validateTextField(
                                descriptionInput,
                                descriptionError,
                                MAX_DESCRIPTION,
                                "Description"
                            );

                            const plainText = quill.getText().trim();
                            const contentValid = validateContent();

                            if (!titleValid || !descriptionValid || !contentValid) {
                                event.preventDefault();

                                const firstInvalid = !titleValid
                                    ? titleInput
                                    : !descriptionValid
                                        ? descriptionInput
                                        : document.getElementById("editor");

                                firstInvalid.focus();
                                return;
                            }

                            if (!plainText) {
                                event.preventDefault();
                                contentError.textContent = "Please write your blog content.";
                                contentError.classList.remove("hidden");
                                document.getElementById("editor").focus();
                                return;
                            }

                            contentInput.value = quill.getSemanticHTML();
                        });

                        const categorySelect = document.getElementById("category");

                        if (categorySelect.dataset.selectedCategory) {
                            categorySelect.value = categorySelect.dataset.selectedCategory;
                        }

                </script>
    </div>