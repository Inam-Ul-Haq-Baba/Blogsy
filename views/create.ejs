<%- include("partials/navbar.ejs") %>
<div class="min-h-screen bg-slate-50 py-10 px-4">

    <form action="/create" method="post"
        class="max-w-2xl mx-auto bg-white border border-slate-200 rounded-2xl shadow-lg p-6 sm:p-8">

        <!-- Heading -->
        <div class="text-center mb-8">
            <p class="text-green-600 font-semibold text-sm mb-1">
                Share your thoughts
            </p>

            <h1 class="text-3xl sm:text-4xl font-bold text-slate-900">
                Create a Blog
            </h1>

            <p class="text-slate-500 text-sm mt-2">
                Where ideas come alive.
            </p>
        </div>


        <!-- Title -->
        <div class="mb-5">
            <label for="title" class="block text-sm font-semibold text-slate-700 mb-2">
                Title
            </label>

            <input
                type="text"
                name="title"
                id="title"
                placeholder="Enter your blog title"
                class="w-full border border-slate-300 rounded-lg px-4 py-3
                       outline-none focus:border-green-500 focus:ring-2
                       focus:ring-green-100 transition"
            >
        </div>


        <!-- Category -->
        <div class="mb-5">
            <label for="category" class="block text-sm font-semibold text-slate-700 mb-2">
                Category
            </label>

            <input
                type="text"
                name="category"
                id="category"
                placeholder="e.g. Technology, Programming, Travel"
                class="w-full border border-slate-300 rounded-lg px-4 py-3
                       outline-none focus:border-green-500 focus:ring-2
                       focus:ring-green-100 transition"
            >
        </div>

        <!--Author-->
        <div class="mb-5">
            <label for="author" class="block text-sm font-semibold text-slate-700 mb-2">
                Author Name
            </label>

            <input
                type="text"
                name="author"
                id="author"
                placeholder="e.g. Your Name"
                class="w-full border border-slate-300 rounded-lg px-4 py-3
                       outline-none focus:border-green-500 focus:ring-2
                       focus:ring-green-100 transition"
            >
        </div>


        <!-- Description -->
        <div class="mb-5">
            <label for="description" class="block text-sm font-semibold text-slate-700 mb-2">
                Description
            </label>

            <input
                type="text"
                name="description"
                id="description"
                placeholder="Write a short description"
                class="w-full border border-slate-300 rounded-lg px-4 py-3
                       outline-none focus:border-green-500 focus:ring-2
                       focus:ring-green-100 transition"
            >
        </div>


        <!-- Content -->
        <div class="mb-7">
            <label for="content" class="block text-sm font-semibold text-slate-700 mb-2">
                Content
            </label>

            <textarea
                name="content"
                id="content"
                rows="8"
                placeholder="Start writing your story..."
                class="w-full border border-slate-300 rounded-lg px-4 py-3
                       outline-none resize-y focus:border-green-500 focus:ring-2
                       focus:ring-green-100 transition"
            ></textarea>
        </div>



        <!-- Submit -->
        <button
            type="submit"
            class="w-full bg-green-600 hover:bg-green-700
                   text-white font-semibold py-3 rounded-lg
                   transition duration-200 shadow-sm">
            ✍️ Publish Blog
        </button>

    </form>

</div>