<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/output.css">
    <link rel="icon" href="/favicon.png" type="image/png">
    <title>Blogsy</title>

    <%- include("google-analytics.ejs") %>
</head>

<body class="font-serif">

    <!-- Navbar -->
    <nav class="border-b-2 bg-white relative z-50">

        <div class="flex justify-between items-center gap-3 px-4 sm:px-8 lg:px-10 py-2">

            <!-- Logo -->
            <a href="/" class="flex-shrink-0">
                <img class="w-20 sm:w-28 md:w-32" src="/logo.png" alt="Blogsy Logo">
            </a>

            <!-- Desktop Navigation -->
            <div class="hidden md:flex items-center">
                <ul class="flex items-center gap-5 lg:gap-8 text-base lg:text-lg font-semibold">

                    <li>
                        <a href="/" class="hover:text-green-600 transition">
                            Home
                        </a>
                    </li>

                    <li>
                        <a href="/about" class="hover:text-green-600 transition">
                            About
                        </a>
                    </li>

                </ul>
            </div>


            <div class="flex justify-between gap-6">
                <!-- Search -->
                <form action="/search" method="GET" class="flex items-center min-w-0">

                    <input type="text" name="q" placeholder="Search blogs..."
                        class="w-24 sm:w-32 lg:w-48 border border-gray-300 rounded-lg px-2 sm:px-3 py-1 md:py-2 text-xs sm:text-sm outline-none focus:border-green-500">

                    <button type="submit" aria-label="Search blogs"
                        class="bg-green-600 hover:bg-green-700 text-white px-2 sm:px-3 py-1 md:py-2 rounded-lg text-sm ml-1">
                        🔍
                    </button>

                </form>

                <!-- Hamburger: Visible on all screen sizes -->
                <button type="button" id="hamburger" class="flex-shrink-0 cursor-pointer "
                    aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobile-menu">

                    <div class="h-1 w-7 my-1 bg-black rounded"></div>
                    <div class="h-1 w-7 my-1 bg-black rounded"></div>
                    <div class="h-1 w-7 my-1 bg-black rounded"></div>

                </button>
            </div>

        </div>

        <!-- Hamburger Menu: Desktop and Mobile -->
        <div id="mobile-menu" class="hidden border-t border-gray-200 bg-white shadow-lg">

            <div class="flex flex-col gap-4 py-5 px-6 max-w-5xl mx-auto">

                


                <!-- <div class="border-t border-gray-200 my-1 md:hidden"></div> -->
                <% if (user) { %>

                    <!-- Logged-in User -->
                    <a href="/profile/<%= user.id %>" class="flex items-center gap-3 hover:text-green-600 transition">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="8" r="4" />
                            <path d="M5 21v-2a7 7 0 0 1 14 0v2" />
                        </svg>
                        <%= user.name %>
                    </a>

                    <a href="/" class="flex items-center gap-3 font-semibold hover:text-green-600 transition md:hidden">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m3 10 9-7 9 7" />
                        <path d="M5 9v12h14V9" />
                        <path d="M9 21v-8h6v8" />
                    </svg>
                    <span>Home</span>
                </a>


                <a href="/about"
                    class="flex items-center gap-3 font-semibold hover:text-green-600 transition md:hidden">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <path d="M12 16v-4" />
                        <path d="M12 8h.01" />
                    </svg>
                    <span>About</span>
                </a>

                    <div class="border-t border-gray-200 my-1"></div>

                    <a href="/my-blogs" class="flex items-center gap-3 hover:text-green-600 transition">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 7v14" />
                            <path
                                d="M3 18V5a2 2 0 0 1 2-2h4a3 3 0 0 1 3 3 3 3 0 0 1 3-3h4a2 2 0 0 1 2 2v13h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3H3z" />
                        </svg>
                        My Blogs
                    </a>


                    <!-- Categories -->
                    <div class="border-t border-gray-200 pt-4">
                        <button type="button" id="categories-toggle"
                            class="flex items-center gap-3 w-full text-left hover:text-green-600 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                                stroke-linejoin="round">
                                <path
                                    d="M20 20H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2Z" />
                            </svg>
                            Categories
                            <span id="categories-arrow" class="ml-auto">+</span>
                        </button>

                        <div id="categories-list" class="hidden flex-col gap-3 pl-4 pt-3">


                            <% if (typeof categories !=="undefined" && categories.length> 0) { %>

                                <% categories.forEach(category=> { %>

                                    <a href="/category/<%= encodeURIComponent(category) %>"
                                        class="text-slate-600 hover:text-green-600 transition">
                                        <%= category %>
                                    </a>

                                    <% }) %>

                                        <% } else { %>

                                            <span class="text-sm text-slate-500">
                                                No categories available
                                            </span>

                                            <% } %>


                        </div>
                    </div>

                    <div class="border-t border-gray-200 pt-4">
                        <a href="/logout" class="font-semibold text-red-600 hover:text-red-700">
                            Logout
                        </a>
                    </div>

                    <% } else { %>

                        <!-- Login -->
                        <a href="/login" class="flex items-center gap-3 hover:text-green-600 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                                stroke-linejoin="round">
                                <path d="M10 17l5-5-5-5" />
                                <path d="M15 12H3" />
                                <path d="M12 3h7a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7" />
                            </svg>
                            Login
                        </a>

                        <!--Register-->
                        <a href="/register" class="flex items-center gap-3 hover:text-green-600 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                                stroke-linejoin="round">
                                <circle cx="9" cy="8" r="4" />
                                <path d="M3 21v-2a6 6 0 0 1 12 0v2" />
                                <path d="M19 8v6" />
                                <path d="M22 11h-6" />
                            </svg>
                            Register
                        </a>

                        <div class="border-t border-gray-200 pt-4">
                            <button type="button" id="categories-toggle"
                                class="flex justify-between items-center w-full text-left font-semibold hover:text-green-600"
                                aria-expanded="false" aria-controls="categories-list">

                                Categories
                                <span id="categories-arrow">+</span>

                            </button>

                            <div id="categories-list" class="hidden flex-col gap-3 pl-4 pt-3">


                                <% if (typeof categories !=="undefined" && categories.length> 0) { %>

                                    <% categories.forEach(category=> { %>

                                        <a href="/category/<%= encodeURIComponent(category) %>"
                                            class="text-slate-600 hover:text-green-600 transition">
                                            <%= category %>
                                        </a>

                                        <% }) %>

                                            <% } else { %>

                                                <span class="text-sm text-slate-500">
                                                    No categories available
                                                </span>

                                                <% } %>


                            </div>
                        </div>

                        <% } %>

            </div>
        </div>



        <!-- Logout Confirmation Modal -->
        <div id="logout-modal" data-csrf-token="<%= csrfToken %>" class="hidden fixed inset-0 z-[100] items-center justify-center bg-black/50 px-4">

            <div class="w-full max-w-sm rounded-2xl bg-white p-6 shadow-xl">

                <div class="mb-4 flex justify-center">
                    <div class="flex h-14 w-14 items-center justify-center rounded-full bg-red-100">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none"
                            stroke="#dc2626" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                            <path d="m16 17 5-5-5-5" />
                            <path d="M21 12H9" />
                        </svg>
                    </div>
                </div>

                <h2 class="mb-2 text-center text-xl font-bold text-slate-800">
                    Confirm Logout
                </h2>

                <p class="mb-6 text-center text-slate-600">
                    Are you sure you want to log out of Blogsy?
                </p>

                <div class="flex gap-3">
                    <button type="button" id="cancel-logout"
                        class="flex-1 rounded-lg border border-slate-300 px-4 py-2.5 font-semibold text-slate-700 hover:bg-slate-100">
                        Cancel
                    </button>

                    <button type="button" id="confirm-logout"
                        class="flex-1 rounded-lg bg-red-600 px-4 py-2.5 font-semibold text-white hover:bg-red-700">
                        Yes, Logout
                    </button>
                </div>

            </div>
        </div>

    </nav>

    
        <% if (user) { %>
            <div class="w-full bg-green-50 border-b border-green-200 px-5 sm:px-8 py-2 flex flex-wrap items-center justify-between gap-3">
                <p class="text-sm sm:text-base text-green-800 font-semibold">
                    Hi, <%= user.name %>
                </p>

                <a href="/my-blogs"
                class="text-sm sm:text-base text-green-700 font-semibold hover:text-green-900 hover:underline">
                    My Blogs
                </a>
            </div>
        <% } else { %>
            <div class="w-full bg-green-50 border-b border-green-200 px-5 sm:px-8 py-2 flex items-center justify-between gap-5">
                <a href="/login"
                class="text-sm sm:text-base text-green-700 font-semibold hover:text-green-900 hover:underline">
                    Login
                </a>

                <a href="/register"
                class="text-sm sm:text-base text-green-700 font-semibold hover:text-green-900 hover:underline">
                    Register
                </a>
            </div>
        <% } %>


            <!-- Navbar JavaScript -->
            <script src="/js/navbar.js"></script>

</body>

</html>