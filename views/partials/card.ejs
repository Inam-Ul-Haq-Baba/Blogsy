<div class="card w-full rounded-xl border border-gray-200 p-3 shadow-sm hover:shadow-md transition-shadow duration-200 flex flex-col">
    <div id="blog-image" class="w-full flex justify-center ">
        
        <img
            src="<%= typeof post.image === 'string' &&
                /^\/(uploads|images)\/[a-zA-Z0-9._-]+$/.test(post.image)
                ? post.image
                : '/images/default-blog.png' %>"
            class="rounded-t-xl w-full h-28 md:h-32 lg:h-44 object-cover"
            alt="<%= post.title %>"
        >

    </div>

    <a href="/category/<%= encodeURIComponent(post.category) %>"
        class="text-sm font-medium text-green-700 hover:text-green-900 hover:underline">
        <%= post.category %>
    </a>

    <p class="card-title text-md font-extrabold mx-3">
        <%= post.title %>
    </p>
    <p class="text-xs text-gray-600 mx-3">
        <%= post.description %>
    </p>
    <div class="details flex justify-between text-[12px] px-2 my-3">

        <a href="/profile/<%= post.user_id %>" class="font-medium text-green-700 hover:underline">
            <%= post.author %>
        </a>

        <span class="text-black">
            <%= new Date(post.date).toLocaleDateString("en-US", {
                month: "short",
                day: "2-digit",
                year: "numeric",
                timeZone: "UTC"
            }).replace(" ", "-").replace(",", ",").toUpperCase() %>
        </span>
        <a href="/posts/<%= post.id %>" class="text-green-700 bg-green-200 px-1 rounded-md">Read More</a>
    </div>
    
    <div class="flex items-center justify-between gap-2 px-2 text-sm text-gray-500 mt-3">
        <div class="flex rounded-full border border-gray-200 px-3 py-1">
            <svg xmlns="http://www.w3.org/2000/svg"
                width="18" height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round">
                <path d="M2.062 12.348a1 1 0 0 1 0-.696
                        10.75 10.75 0 0 1 19.876 0
                        1 1 0 0 1 0 .696
                        10.75 10.75 0 0 1-19.876 0"/>
                <circle cx="12" cy="12" r="3"/>
            </svg>

            <span><%= post.views ?? 0 %> views</span>

        </div>
        
        <div class="flex items-center gap-4">

            <button
                type="button"
                class="card-like-button flex items-center gap-2 rounded-full border border-gray-200 px-3 py-1 transition hover:bg-green-50 <%= post.user_liked ? 'text-green-600' : 'text-gray-600' %>"
                data-post-id="<%= post.id %>"
                data-liked="<%= post.user_liked ? 'true' : 'false' %>"
                aria-pressed="<%= post.user_liked ? 'true' : 'false' %>"
                aria-label="Like this blog">

                <svg
                    class="card-like-icon w-5 h-5 transition-colors duration-200"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="<%= post.user_liked ? 'currentColor' : 'none' %>"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true">

                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78Z"/>
                </svg>

                <span class="card-like-count"><%= post.like_count ?? 0 %></span>

                <span>Likes</span>

            </button>

        </div>


    </div>

</div>