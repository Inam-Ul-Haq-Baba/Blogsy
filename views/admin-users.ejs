
<!DOCTYPE html>
<html lang="en">

<body class="bg-slate-50">

    <%- include("partials/navbar.ejs") %>

    <main class="mx-auto max-w-6xl px-5 py-10">

        <h1 class="text-3xl font-bold text-slate-900">
            Admin — User Management
        </h1>

        <p class="mt-2 mb-8 text-slate-600">
            View and manage registered Blogsy users.
        </p>

        <div class="mb-5 rounded-lg border border-green-200 bg-green-50 p-4">
            <p class="font-semibold text-green-800">
                Total registered users: <%= users.length %>
            </p>
        </div>

        <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
            <table class="w-full text-left text-sm">
                <thead class="bg-slate-100 text-slate-700">
                    <tr>
                        <th class="px-5 py-4">ID</th>
                        <th class="px-5 py-4">Name</th>
                        <th class="px-5 py-4">Username</th>
                        <th class="px-5 py-4">Email</th>
                        <th class="px-5 py-4">Action</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-200">

                    <% if (users.length === 0) { %>
                        <tr>
                            <td colspan="5" class="px-5 py-8 text-center text-slate-500">
                                No registered users found.
                            </td>
                        </tr>
                    <% } %>

                    <% users.forEach(function(account) { %>
                        <tr class="hover:bg-slate-50">
                            <td class="px-5 py-4"><%= account.id %></td>
                            <td class="px-5 py-4"><%= account.name %></td>
                            <td class="px-5 py-4"><%= account.username %></td>
                            <td class="px-5 py-4"><%= account.email %></td>

                            <td class="px-5 py-4">
                                <% if (Number(account.id) === Number(user.id)) { %>
                                    <span class="text-xs text-slate-500">
                                        Your account
                                    </span>
                                <% } else { %>
                                    <form
                                        method="POST"
                                        action="/admin/users/<%= account.id %>/delete"
                                        onsubmit="return confirm('Permanently delete this user and their posts and comments? This cannot be undone.');"
                                    >
                                        <input
                                            type="hidden"
                                            name="_csrf"
                                            value="<%= csrfToken %>"
                                        >

                                        <button
                                            type="submit"
                                            class="rounded-lg bg-red-600 px-3 py-2 font-semibold text-white hover:bg-red-700"
                                        >
                                            Delete
                                        </button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>

                </tbody>
            </table>
        </div>

        <div class="mt-6">
            <a href="/" class="font-semibold text-green-700 hover:underline">
                &larr; Back to Blogsy
            </a>
        </div>

    </main>

</body>
</html>
