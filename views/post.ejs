<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="/css/output.css">
    <link rel="icon" href="/favicon.png" type="image/x-icon">

    <title>Blogsy</title>
</head>

<body class="bg-slate-50">

    <%- include("partials/navbar.ejs") %>

    <main class="max-w-4xl mx-auto px-5 py-10">

        <!-- Category -->
        <p class="text-green-600 font-semibold text-sm mb-3">
            <%= post.category %>
        </p>

        <!-- Title -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-slate-900 mb-4">
            <%= post.title %>
        </h1>

        <!-- Author & Date -->
        <div class="flex gap-3 text-sm text-slate-500 mb-8">
            <span>By <%= post.author %></span>
            <span>•</span>
            <span><%= post.date %></span>
        </div>

        <!-- Image -->
        <img 
            src="<%= post.image %>" 
            alt="<%= post.title %>"
            class="w-full h-64 sm:h-80 object-cover rounded-xl mb-8"
        >

        <!-- Description -->
        <p class="text-lg font-semibold text-slate-700 mb-6">
            <%= post.description %>
        </p>

        <!-- Content -->
        <div class="text-base sm:text-lg text-slate-700 leading-8">
            <%= post.content %>
        </div>

        <!-- Back button -->
        <div class="mt-10">
            <a 
                href="/"
                class="inline-block bg-green-600 hover:bg-green-700 text-white font-semibold px-4 py-2 rounded-md"
            >
                ← Back to Blogs
            </a>
        </div>

    </main>

    <script src="/js/script.js"></script>

</body>

</html>