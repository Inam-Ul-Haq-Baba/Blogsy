<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= post.title %> | Blogsy</title>

    <link rel="icon" href="/favicon.png" type="image/png" sizes="any">
</head>

<body class="bg-slate-50">

    <%- include("partials/navbar.ejs") %>

    
    <% if (typeof success !== "undefined" && success) { %>
        <div id="success-message"
            class="mx-auto mt-4 max-w-6xl rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-700 transition-opacity duration-500"
            role="status">
            <%= success %>
        </div>
    <% } %>

        <main class="max-w-4xl mx-auto px-5 py-10 whitespace-normal">

            <!-- Category -->
            <p class="text-green-600 font-semibold text-sm mb-3">
                <%= post.category %>
            </p>

            <!-- Title -->
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-slate-900 mb-4">
                <%= post.title %>
            </h1>

            <!-- Author & Date -->
            <div class="flex gap-3 text-sm text-slate-500 mb-8">

                <a href="/profile/<%= post.user_id %>"
                    class="font-semibold text-green-700 hover:text-green-800 hover:underline">
                    <%= post.author %>
                </a>

                <span>•</span>
                <span>
                    <%= new Date(post.date).toLocaleDateString("en-US", {
                        month: "short",
                        day: "numeric",
                        year: "numeric",
                        timeZone: "UTC"
                    }) %>
                </span>
            </div>


            <!-- Image -->
            <div class="mb-6">
                <img
                    id="post-full-image"
                    src="<%= typeof post.image === 'string' &&
                        (
                            /^\/(uploads|images)\/[a-zA-Z0-9._-]+$/.test(post.image) ||
                            post.image.startsWith('https://res.cloudinary.com/')
                        )
                        ? post.image
                        : '/images/default-blog.png' %>"
                    alt="<%= post.title %>"
                    class="w-full max-h-[500px] object-contain rounded-xl cursor-zoom-in"
                >
            </div>


            <!-- Description -->
            <div class="mb-10 rounded-lg border-l-4 border-green-600 bg-green-50 px-5 py-4">
                <p class="text-left break-words text-base sm:text-lg font-medium text-slate-600 leading-8">
                    <%= post.description.trim() %>
                </p>
            </div>

            <!-- Content -->
            <div class="blog-content text-left text-base sm:text-lg text-slate-700 leading-8">
                <%- post.formattedContent %>
            </div>

            <div class=" flex items-center justify-between px-3">
                <p class="flex items-center gap-2 text-sm text-gray-500 mt-2">
                    <span>👁</span>
                    <span><%= post.views ?? 0 %> views</span>
                </p>

                
                <div class="flex items-center gap-4 mt-4">

                    <button
                        type="button"
                        id="like-button"
                        data-post-id="<%= post.id %>"
                        data-liked="<%= userLiked %>"
                        class="flex items-center gap-2 rounded-full border border-gray-200 px-4 py-2 transition hover:bg-green-50 <%= userLiked ? 'text-green-600' : 'text-gray-600' %>"
                        aria-pressed="<%= userLiked %>">

                        <span id="like-icon"><%= userLiked ? '♥' : '♡' %></span>

                        <span id="like-count"><%= likeCount %></span>

                        <span>Likes</span>
                    </button>
                </div>

            </div>


            <!-- Back button -->
            <div class="mt-10">
                <a href="/"
                    class="inline-block bg-green-600 hover:bg-green-700 text-white font-semibold px-4 py-2 rounded-md">
                    ← Back to Blogs
                </a>
            </div>


            <section class="mt-12 border-t border-slate-200 pt-8">
                <h2 class="text-2xl font-bold text-slate-900 mb-6">
                    Comments (<%= comments.length %>)
                </h2>

                <% if (user) { %>
                    <form action="/posts/<%= post.id %>/comments" method="POST" class="mb-8">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <label for="content" class="block text-sm font-semibold mb-2">
                            Write a comment
                        </label>

                        <textarea id="content" name="content" rows="4" maxlength="2000" required
                            placeholder="Share your thoughts..."
                            class="w-full rounded-lg border border-slate-300 p-3 focus:outline-none focus:ring-2 focus:ring-green-500"></textarea>

                        <button type="submit"
                            class="mt-3 rounded-lg bg-green-600 px-5 py-2 text-white font-semibold hover:bg-green-700">
                            Post Comment
                        </button>
                    </form>
                    <% } else { %>
                        <p class="mb-6 text-slate-600">
                            <a href="/login" class="text-green-700 font-semibold hover:underline">
                                Log in
                            </a>
                            to leave a comment.
                        </p>
                        <% } %>

                            <% if (comments.length===0) { %>
                                <p class="text-slate-500">No comments yet. Be the first to comment!</p>
                                <% } else { %>


                                    <div class="space-y-2">
                                        <% comments.forEach(comment=> { %>

                                            <article class="rounded-lg border border-slate-200 bg-white px-3 py-2">
                                                <div class="flex flex-wrap items-center justify-between gap-3">
                                                    <h3 class="text-sm font-semibold text-slate-900">
                                                        <%= comment.author %>
                                                    </h3>

                                                    <span class="text-xs text-slate-500">
                                                        <%= new Date(comment.created_at).toLocaleString() %>
                                                    </span>
                                                </div>

                                                <p
                                                    class="mt-1 text-sm text-slate-700 text-left whitespace-pre-wrap break-words">
                                                    <%= comment.content %>
                                                </p>

                                                <% if (user && user.id===comment.user_id) { %>

                                                    <div class="mt-2 flex items-center gap-3">
                                                        <a href="/comments/<%= comment.id %>/edit"
                                                            class="inline-flex items-center text-sm font-medium text-blue-600 hover:underline">
                                                            Edit
                                                        </a>

                                                        <form action="/comments/<%= comment.id %>/delete" method="POST"
                                                            class="flex items-center"
                                                            onsubmit="return confirm('Are you sure you want to delete this comment?');">

                                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                            
                                                            <button type="submit"
                                                                class="inline-flex items-center text-sm font-medium text-red-600 hover:underline">
                                                                Delete
                                                            </button>
                                                        </form>
                                                    </div>

                                                    <% } %>
                                            </article>

                                            <% }) %>
                                    </div>


                                    <% } %>
            </section>

            
            <!-- Full Image Viewer -->
            <div
                id="image-viewer"
                class="hidden fixed inset-0 z-50 bg-black/90 items-center justify-center p-4"
            >
                <button
                    id="close-image-viewer"
                    type="button"
                    class="absolute top-4 right-5 text-white text-4xl leading-none"
                    aria-label="Close image viewer"
                >
                    &times;
                </button>

                <img
                    id="viewer-image"
                    src=""
                    alt=""
                    class="max-w-full max-h-[90vh] object-contain rounded-lg"
                >
            </div>

        </main>

        
        <script type="application/ld+json">
        <%- JSON.stringify({
            "@context": "https://schema.org",
            "@type": "BlogPosting",
            "mainEntityOfPage": {
                "@type": "WebPage",
                "@id": `https://blogsy-swhh.onrender.com/posts/${post.id}`
            },
            "headline": post.title,
            "description": seoDescription || "Read this article on Blogsy, where ideas come alive.",
            "image": seoImage,
            "datePublished": new Date(post.date).toISOString(),
            "author": {
                "@type": "Person",
                "name": post.author
            },
            "publisher": {
                "@type": "Organization",
                "name": "Blogsy",
                "url": "https://blogsy-swhh.onrender.com"
            }
        }) %>
        </script>


        <script src="/js/script.js"></script>

</body>

</html>