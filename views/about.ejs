<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="/css/output.css">
    <link rel="icon" href="/favicon.png" type="image/png">

    <title>About | Blogsy</title>
</head>

<body class="bg-slate-50">

    <!-- Navbar -->
    <%- include("partials/navbar.ejs") %>


    <!-- About Hero -->
    <section class="text-center py-14 px-5 border-b-2 bg-white">

        <p class="text-green-600 font-semibold text-lg mb-2">
            Welcome to Blogsy
        </p>

        <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 mb-4">
            About Blogsy
        </h1>

        <p class="text-xl text-green-600 font-semibold mb-4">
            Where ideas come alive.
        </p>

        <p class="max-w-2xl mx-auto text-sm sm:text-base text-slate-600">
            Blogsy is a simple blogging platform where people can share
            their thoughts, stories, knowledge and experiences with the world.
        </p>

    </section>


    <!-- What is Blogsy -->
    <section class="max-w-6xl mx-auto px-5 py-14">

        <div class="flex flex-col md:flex-row items-center gap-10">

            <!-- Image -->
            <div class="w-full md:w-1/2">

                <img
                    src="/hero_img.png"
                    alt="About Blogsy"
                    class="w-full rounded-xl"
                >

            </div>


            <!-- Text -->
            <div class="w-full md:w-1/2">

                <p class="text-green-600 font-semibold mb-2">
                    What is Blogsy?
                </p>

                <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-5">
                    A place for your ideas
                </h2>

                <p class="text-slate-600 leading-7 mb-4">
                    Blogsy was created to make sharing ideas simple.
                    Whether you're writing about technology, programming,
                    travel, lifestyle or something completely different,
                    Blogsy gives you a place to express yourself.
                </p>

                <p class="text-slate-600 leading-7">
                    Write your thoughts, share your experiences and
                    discover new perspectives from different people and
                    different topics.
                </p>

            </div>

        </div>

    </section>


    <!-- Why Blogsy -->
    <section class="bg-white py-14 px-5 border-y-2">

        <div class="max-w-6xl mx-auto">

            <div class="text-center mb-10">

                <p class="text-green-600 font-semibold mb-2">
                    Why Blogsy?
                </p>

                <h2 class="text-3xl sm:text-4xl font-bold text-slate-900">
                    Share. Learn. Grow.
                </h2>

            </div>


            <!-- Cards -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

                <!-- Share -->
                <div class="border border-slate-200 rounded-xl p-6 text-center shadow-sm">

                    <div class="text-4xl mb-4">
                        ✍️
                    </div>

                    <h3 class="text-xl font-bold text-slate-900 mb-3">
                        Share
                    </h3>

                    <p class="text-sm text-slate-600 leading-6">
                        Turn your thoughts and experiences into
                        meaningful stories and share them with others.
                    </p>

                </div>


                <!-- Learn -->
                <div class="border border-slate-200 rounded-xl p-6 text-center shadow-sm">

                    <div class="text-4xl mb-4">
                        📖
                    </div>

                    <h3 class="text-xl font-bold text-slate-900 mb-3">
                        Learn
                    </h3>

                    <p class="text-sm text-slate-600 leading-6">
                        Discover new ideas, knowledge and perspectives
                        through stories from different topics.
                    </p>

                </div>


                <!-- Grow -->
                <div class="border border-slate-200 rounded-xl p-6 text-center shadow-sm">

                    <div class="text-4xl mb-4">
                        🌱
                    </div>

                    <h3 class="text-xl font-bold text-slate-900 mb-3">
                        Grow
                    </h3>

                    <p class="text-sm text-slate-600 leading-6">
                        Write, learn and explore new perspectives
                        that help you grow along the way.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- Topics -->
    <section class="max-w-5xl mx-auto text-center py-14 px-5">

        <p class="text-green-600 font-semibold mb-2">
            Explore
        </p>

        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">
            Something for Everyone
        </h2>

        <p class="text-slate-600 mb-8">
            Explore different topics and discover something interesting.
        </p>


        <div class="flex flex-wrap justify-center gap-3">

            <span class="px-4 py-2 bg-green-100 text-green-700 rounded-full text-sm font-semibold">
                Technology
            </span>

            <span class="px-4 py-2 bg-green-100 text-green-700 rounded-full text-sm font-semibold">
                Programming
            </span>

            <span class="px-4 py-2 bg-green-100 text-green-700 rounded-full text-sm font-semibold">
                Travel
            </span>

            <span class="px-4 py-2 bg-green-100 text-green-700 rounded-full text-sm font-semibold">
                Lifestyle
            </span>

            <span class="px-4 py-2 bg-green-100 text-green-700 rounded-full text-sm font-semibold">
                Education
            </span>

            <span class="px-4 py-2 bg-green-100 text-green-700 rounded-full text-sm font-semibold">
                Personal Growth
            </span>

        </div>

    </section>


    <!-- Call To Action -->
    <section class="bg-slate-900 text-white text-center py-14 px-5">

        <h2 class="text-3xl sm:text-4xl font-bold mb-4">
            Have something to say?
        </h2>

        <p class="text-slate-300 mb-7">
            Your next idea could inspire someone.
        </p>

        <div class="flex flex-col sm:flex-row justify-center gap-4">

            <a
                href="/create"
                class="bg-green-600 hover:bg-green-700 px-5 py-3 rounded-md font-semibold"
            >
                ✍️ Write a Blog
            </a>

            <a
                href="/"
                class="border border-white hover:bg-white hover:text-slate-900 px-5 py-3 rounded-md font-semibold"
            >
                Explore Blogs
            </a>

        </div>

    </section>


    <!-- Footer -->
    <footer class="bg-white py-8 px-5 border-t">

        <div class="max-w-6xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4">

            <div class="text-center sm:text-left">

                <h3 class="text-xl font-bold text-slate-900">
                    Blog<span class="text-green-600">sy.</span>
                </h3>

                <p class="text-sm text-slate-500">
                    Where ideas come alive.
                </p>

            </div>


            <div class="flex gap-6 text-sm font-semibold text-slate-600">

                <a href="/" class="hover:text-green-600">
                    Home
                </a>

                <a href="/about" class="hover:text-green-600">
                    About
                </a>

                <a href="/create" class="hover:text-green-600">
                    Write
                </a>

            </div>

        </div>


        <p class="text-center text-xs text-slate-400 mt-6">
            © 2026 Blogsy. All rights reserved.
        </p>

    </footer>


    <script src="/js/script.js"></script>

</body>

</html>