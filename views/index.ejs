<%- include("partials/navbar.ejs") %>

    
    <% if (typeof success !== "undefined" && success) { %>
        <div id="success-message"
            class="mb-6 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-700 transition-opacity duration-500"
            role="status">
            <%= success %>
        </div>
    <% } %>


    <hero class="flex flex-col md:flex-row justify-around items-center bg-slate-50 py-2 px-0 md:px-5 border-b-2">
        <div class="px-8 lg:px-0 text-center md:text-left md:justify-center">
            <p class="text-md sm:text-xl  font-bold text-green-500 ">Welcome to Blogsy</p>
            <p class="text-xl sm:text-4xl lg:text-5xl font-bold pb-2">Where ideas Come <span
                    class="text-green-600">alive</span></p>
            <p class="text-xs sm:text-base py-2">Share your ideas, knowledge, experiences, and projects with the world. Discover new perspectives and inspire others through what you create
            </p>
            <a href="/create"
                class="bg-green-600 text-xs md:text-sm text-white font-semibold rounded-md px-3 py-2">✏️Write
                a
                Blog &nbsp;</a>
        </div>
        <img class="w-4/5 md:w-1/3 " src="hero_img.png" alt="Image Not Found">
    </hero>


    <div id="latest-blogs"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 py-4 px-10 sm:px-4 md:px-16 lg:px-10">

        <% posts.forEach(post=> { %>
            <%- include("partials/card.ejs", {post}) %>
                <% }) %>

    </div>


    <!--  Pagination  -->
    <% if (totalPages> 1) { %>
        <nav class="mt-10 flex flex-wrap items-center justify-center gap-2" aria-label="Blog pagination">

            <% if (currentPage> 1) { %>
                <a href="/?page=<%= currentPage - 1 %>"
                    class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-green-50">
                    Previous
                </a>
                <% } %>

                    <% for (let page=1; page <=totalPages; page++) { %>
                        <a href="/?page=<%= page %>" class="rounded-lg border px-4 py-2 text-sm font-medium
               <%= page === currentPage
                   ? 'bg-green-600 text-white border-green-600'
                   : 'border-slate-300 text-slate-700 hover:bg-green-50' %>">
                            <%= page %>
                        </a>
                        <% } %>

                            <% if (currentPage < totalPages) { %>
                                <a href="/?page=<%= currentPage + 1 %>"
                                    class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-green-50">
                                    Next
                                </a>
                                <% } %>

        </nav>
        <% } %>



        <%- include("partials/footer.ejs") %>

    <script src="/js/script.js"></script>
</body>

</html>