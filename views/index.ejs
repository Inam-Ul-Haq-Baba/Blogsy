<%- include("partials/navbar.ejs") %>

    <hero class="flex flex-col md:flex-row justify-around items-center bg-slate-50 py-2 px-0 md:px-5 border-b-2">
        <div class="px-8 lg:px-0 text-center md:text-left md:justify-center">
            <p class="text-md sm:text-xl  font-bold text-green-500 ">Welcome to Blogsy</p>
            <p class="text-xl sm:text-4xl lg:text-5xl font-bold pb-2">Where ideas Come <span
                    class="text-green-600">alive</span></p>
            <p class="text-xs sm:text-base py-2">Share your thoughts, stories, Knowledge and experience with the world.
            </p>
            <button class="bg-green-600 text-xs md:text-sm text-white font-semibold rounded-md px-3 py-2">Explore
                Blogs</button>
        </div>
        <img class="w-4/5 md:w-1/3 " src="hero_img.png" alt="Image Not Found">
    </hero>


    <div id="latest-blogs" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 py-4 px-10 sm:px-4 md:px-16 lg:px-10">
        
        <% posts.forEach(post => { %>
            <%- include("partials/card.ejs", {post}) %>
        <% }) %>

    </div>


    <script src="/js/script.js"></script>
    </body>

    </html>